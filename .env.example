OPENALEX_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
EVIDENSIA_CONTACT_EMAIL=

# Optional OpenAI Responses API research model. If OPENAI_API_KEY is unset,
# planning, synthesis, and verification use deterministic local fallbacks.
OPENAI_API_KEY=
EVIDENSIA_OPENAI_MODEL=gpt-5.4-mini
EVIDENSIA_OPENAI_BASE_URL=https://api.openai.com/v1
EVIDENSIA_OPENAI_REASONING_EFFORT=low
EVIDENSIA_OPENAI_TIMEOUT=45
EVIDENSIA_OPENAI_MAX_OUTPUT_TOKENS=3000

# Optional OpenAI-compatible or custom JSON provider endpoints. When unset,
# Evidensia uses deterministic local embedding, reranking, and entailment.
EVIDENSIA_EMBEDDING_URL=
EVIDENSIA_EMBEDDING_API_KEY=
EVIDENSIA_EMBEDDING_MODEL=
EVIDENSIA_RERANK_URL=
EVIDENSIA_RERANK_API_KEY=
EVIDENSIA_RERANK_MODEL=
EVIDENSIA_ENTAILMENT_URL=
EVIDENSIA_ENTAILMENT_API_KEY=
EVIDENSIA_ENTAILMENT_MODEL=
